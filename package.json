{
  "name": "colis",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Calcule les frais douaniers par categorie tarifaire des envois hors UE : droit forfaitaire de 3 EUR et frais de traitement de 2 EUR, par sous-position du Systeme harmonise.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.js test/*.test.js",
    "sync:taric": "node tools/taric-sync/sync.js",
    "watch:rules": "node tools/rules-watch/watch.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:local": "node tools/build-local/build.js",
    "verify:local": "node tools/build-local/verify.js",
    "check:negative": "node tools/negative-control/check.js",
    "probe:coverage": "node tools/coverage-probe/probe.js",
    "test:concept": "node tools/concept-test/run.js",
    "test:extension": "node tools/extension-test/run.js",
    "check": "npm run lint && npm test && npm run typecheck && npm run check:negative && npm run verify:local && npm run test:extension",
    "serve:test": "node tools/serve-test/server.js",
    "check:deploy": "node tools/deploy-gate/check.js",
    "typecheck": "npm run build:local --silent && tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "wrangler": "4.42.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "author": "amdjadouxx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amdjadouxx/colis.git"
  },
  "bugs": {
    "url": "https://github.com/amdjadouxx/colis/issues"
  },
  "homepage": "https://github.com/amdjadouxx/colis#readme",
  "keywords": [
    "douane",
    "taric",
    "systeme-harmonise",
    "frais-importation",
    "ecommerce",
    "extension-navigateur"
  ]
}
